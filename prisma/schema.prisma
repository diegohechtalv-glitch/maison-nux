// Base: Neon (Postgres). DATABASE_URL = cadena con -pooler (runtime),
// DIRECT_URL = cadena sin pooler (migraciones). Ambas viven solo en .env.local
// y en las variables de Vercel, nunca en el repositorio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Las 4 presentaciones. La única fuente de verdad del contenido es
// lib/productos.ts: el seed vuelca ese archivo aquí. No editar a mano.
model Producto {
  id             String   @id
  gramos         Int
  precioCentavos Int
  foto           String
  nombre         String
  frase          String
  parrafo        String
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt
}

// Configuración editable sin tocar código ni redesplegar: se edita esta fila
// (desde el admin en la fase 6, o en la consola de Neon mientras tanto) y el
// sitio la lee en vivo. La clave "envios" guarda zonas, costos y umbrales;
// el respaldo por defecto vive en lib/config-envios.ts.
model Configuracion {
  clave         String   @id
  datos         Json
  actualizadoEn DateTime @updatedAt
}

// Pedidos. Un pedido nace `pendiente` al crear la preferencia de Mercado Pago
// y SOLO el webhook (verificando la firma) lo pasa a `pagado` o `fallido`.
// Estados: pendiente | pagado | enviado | entregado | cancelado | fallido.
model Pedido {
  id               String       @id @default(cuid())
  numero           Int          @unique @default(autoincrement())
  estado           String       @default("pendiente")

  // Datos del cliente. No se escriben en logs ni se exponen en APIs públicas.
  nombre           String
  correo           String
  telefono         String // formato 521 + 10 dígitos
  calle            String
  colonia          String
  ciudad           String
  estadoEnvio      String
  codigoPostal     String

  zonaId           String
  subtotalCentavos Int
  envioCentavos    Int
  totalCentavos    Int

  mpPreferenceId   String?
  mpPaymentId      String?

  creadoEn         DateTime     @default(now())
  actualizadoEn    DateTime     @updatedAt
  items            PedidoItem[]
}

// Copia congelada de cada línea al momento de comprar: si mañana cambian
// precios o nombres, el pedido histórico no se mueve.
model PedidoItem {
  id             String @id @default(cuid())
  pedidoId       String
  pedido         Pedido @relation(fields: [pedidoId], references: [id])
  productoId     String
  nombre         String
  gramos         Int
  precioCentavos Int
  cantidad       Int
}
