# Copia este archivo como .env.local y llena los valores.
# .env.local está en .gitignore: las llaves NUNCA van al repositorio.
#
# Estas mismas variables van en Vercel → Settings → Environment Variables.

# Neon — cadena CON -pooler (el sitio en marcha)
DATABASE_URL=

# Neon — cadena SIN pooler (solo migraciones de Prisma)
DIRECT_URL=

# Mercado Pago — token del servidor (TEST- en pruebas, APP_USR- en producción).
# Jamás llega al navegador.
MP_ACCESS_TOKEN=

# Mercado Pago — llave pública
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Mercado Pago — firma secreta del webhook (la da el panel al crear el aviso)
MP_WEBHOOK_SECRET=

# Resend — llave de API para los correos
RESEND_API_KEY=

# Dirección pública del sitio, SIN diagonal al final (ej. https://tudominio.com)
NEXT_PUBLIC_SITE_URL=

# A dónde llegan los avisos de pedido nuevo
CONTACTO_EMAIL=

# Contraseña del panel /admin. Larga (20+ caracteres) y generada con un gestor
# de contraseñas. Sin ella el panel queda cerrado por completo.
ADMIN_PASSWORD=

# Opcionales
# CORREO_REMITENTE=       # con dominio verificado en Resend (fase 7)
# CONTACTO_WHATSAPP=      # formato 521 + 10 dígitos
